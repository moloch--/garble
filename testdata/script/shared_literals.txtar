GLOBAL_SHARED_STRING_SECRET_194_2026 LOCAL_SHARED_STRING_SECRET_194_2026 MUTABLE_BYTES_STRING_SECRET_194_2026 LINKED_SHARED_STRING_SECRET_194_2026 embedded-ok
